# Skopiuj do .env (plik .env jest w .gitignore). Wszystko jest opcjonalne.

# Strona FB z wydarzeniami (domyślnie https://www.facebook.com/allinuj)
# FB_PAGE_URL=https://www.facebook.com/allinuj

# Tylko jeśli FB zacznie wymagać logowania (cookies z pobocznego konta):
# FB_COOKIES=c_user=123; xs=abc

# Powiadomienia e-mail o nowych wydarzeniach (Gmail: hasło aplikacji, patrz README)
# SMTP_USER=twoj.adres@gmail.com
# SMTP_PASS=abcd efgh ijkl mnop
# NOTIFY_TO=inny.adres@example.com

# Opcjonalnie: dodatkowo zapisuj wydarzenia przez Google Calendar API (konto serwisowe, patrz README)
# GOOGLE_CALENDAR_ID=xxxxxxxx@group.calendar.google.com
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
